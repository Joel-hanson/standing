<?xml version="1.0" encoding="utf-8"?>
<!--
  Host this as appcast.xml (GitHub Pages, raw release asset, or any HTTPS URL).
  Point STANDING_SPARKLE_FEED_URL at that URL when packaging Standing.app.

  Generate keys once:
    # From Sparkle tools (or: brew install sparkle)
    generate_keys
  Keep the private key offline. Put the public key in STANDING_SPARKLE_PUBLIC_ED_KEY.

  Each release:
    1. Bump STANDING_APP_VERSION / STANDING_APP_BUILD
    2. Notarize Standing.dmg
    3. sign_update Standing.dmg   # prints sparkle:edSignature + length
    4. Add an <item> below and publish
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>Standing</title>
    <language>en</language>

    <item>
      <title>Version 0.2.0</title>
      <pubDate>Sun, 18 Oct 2026 12:00:00 +0000</pubDate>
      <sparkle:version>3</sparkle:version>
      <sparkle:shortVersionString>0.2.0</sparkle:shortVersionString>
      <description><![CDATA[
        <ul>
          <li>Mac App Store packaging path and privacy policy</li>
          <li>Improved app icon and update messaging</li>
        </ul>
      ]]></description>
      <enclosure
        url="https://github.com/YOU/standing/releases/download/v0.2.0/Standing.dmg"
        sparkle:edSignature="REPLACE_WITH_sign_update_OUTPUT"
        length="12345678"
        type="application/octet-stream"
      />
    </item>
  </channel>
</rss>
