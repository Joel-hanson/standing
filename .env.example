# Optional fallback. Preferred: menu bar → Set TypeSafe API key… (macOS Keychain).
TYPESAFE_API_KEY=your_api_key_here

# One-time Support link (Settings + menu). Default: https://buymeacoffee.com/joelhanson
# STANDING_SUPPORT_URL=https://buymeacoffee.com/joelhanson

# Sparkle in-app updates (direct DMG packaging only — never commit private keys).
# STANDING_APP_VERSION=0.2.0
# STANDING_APP_BUILD=3
# STANDING_SPARKLE_FEED_URL=https://YOUR_HOST/appcast.xml
# STANDING_SPARKLE_PUBLIC_ED_KEY=

# Mac App Store packaging (./scripts/package-mas.sh) — never commit certs/profiles.
# STANDING_MAS_APP_IDENTITY=Apple Distribution: Your Name (TEAMID)
# STANDING_MAS_INSTALLER_IDENTITY=3rd Party Mac Developer Installer: Your Name (TEAMID)
# STANDING_MAS_PROVISIONING_PROFILE=/path/to/Standing_MAS.provisionprofile
