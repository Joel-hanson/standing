# Optional fallback. Preferred: menu bar → Set TypeSafe API key… (macOS Keychain).
TYPESAFE_API_KEY=your_api_key_here

# One-time Support link (Settings + menu). Default: https://gumroad.com/l/standing
# STANDING_SUPPORT_URL=https://gumroad.com/l/your-product

# Sparkle in-app updates (Lane B packaging only — never commit private keys).
# STANDING_APP_VERSION=0.1.0
# STANDING_APP_BUILD=1
# STANDING_SPARKLE_FEED_URL=https://YOUR_HOST/appcast.xml
# STANDING_SPARKLE_PUBLIC_ED_KEY=
